datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

model Product {
  id          String  @id @default(uuid())
  koleksiyonu String
  olcusu      String
  renk        String
  finish      String?
  imagePath   String
  slug        String   @unique

  FeaturedProduct FeaturedProduct[]
  images          ProductImage[]
}

model Setting {
  key       String  @id
  value     Json
  updatedAt DateTime @updatedAt
}

enum BannerStatus {
  ACTIVE
  INACTIVE
}

enum BannerPosition {
  HERO
  SECONDARY
  FOOTER
}

model Banner {
  id          String         @id @default(uuid())
  title       String
  subtitle    String?
  imageUrl    String
  link        String?
  buttonText  String?
  status      BannerStatus   @default(ACTIVE)
  position    BannerPosition @default(HERO)
  order       Int            @default(0)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
}

model FeaturedProduct {
  id        Int     @id @default(autoincrement())
  position  Int     @unique
  productId String
  product   Product @relation(fields: [productId], references: [id], onDelete: Cascade)
}

model CollectionMeta {
  id            Int      @id @default(autoincrement())
  name          String   @unique
  coverImageUrl String?
  description   String?
  updatedAt     DateTime @updatedAt
}

model Feature {
  id          Int      @id @default(autoincrement())
  position    Int      @unique
  title       String
  description String
  icon        String?
  imageUrl    String?
  updatedAt   DateTime @updatedAt
}

model ProductImage {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  imagePath String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}
